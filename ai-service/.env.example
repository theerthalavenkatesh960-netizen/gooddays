# ─── GoodDays AI Service — local dev ────────────────────────────────────────
# Copy to .env and fill in your values

DATABASE_URL=postgresql://postgres:password@localhost:5432/gooddays

# "local" uses Ollama, "claude" uses Anthropic API
AI_PROVIDER=local

# Ollama (used when AI_PROVIDER=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Anthropic (used when AI_PROVIDER=claude)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
