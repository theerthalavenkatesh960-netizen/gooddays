// fitnessService.js

// ── STEP 1: YOU DO ALL MATH ──────────────────────────────
function computeProfile(profile) {
  const today = new Date();
  const targetDate = new Date(profile.targetDate);
  const days_remaining = Math.round(
    (targetDate - today) / (1000 * 60 * 60 * 24)
  );

  // THIS is where llama got it wrong — you do it instead
  const weight_delta = parseFloat(
    (profile.targetWeight - profile.currentWeight).toFixed(1)
  );

  const weekly_change = parseFloat(
    ((weight_delta / days_remaining) * 7).toFixed(2)
  );

  // goal_type derived by YOU, not llama
  const goal_type =
    weight_delta > 0 ? "bulk" :
    weight_delta < 0 ? "cut" :
    "maintain";

  const heightM = profile.height / 100;
  const bmi = parseFloat(
    (profile.currentWeight / (heightM * heightM)).toFixed(1)
  );

  const bmr = Math.round(
    profile.gender === "male"
      ? (10 * profile.currentWeight) + (6.25 * profile.height) - (5 * profile.age) + 5
      : (10 * profile.currentWeight) + (6.25 * profile.height) - (5 * profile.age) - 161
  );

  const multipliers = {
    sedentary: 1.2, light: 1.375, moderate: 1.55,
    active: 1.725, "very-active": 1.9
  };
  const tdee = Math.round(bmr * (multipliers[profile.activityLevel] || 1.55));
  const daily_adjustment = Math.round((weight_delta * 7700) / days_remaining);
  const recommended_calories = tdee + daily_adjustment;

  // Calorie bucket
  const buckets = [1500, 1800, 2000, 2400, 2700, 3000, 3500];
  const daily_calories = buckets.reduce((a, b) =>
    Math.abs(b - recommended_calories) < Math.abs(a - recommended_calories) ? b : a
  );

  // Macros — YOU compute these too
  const macros = computeMacros(goal_type, daily_calories, profile);

  // Milestones — YOU generate dates
  const milestones = [1, 2, 3, 4].map(i => {
    const d = new Date(today);
    d.setDate(d.getDate() + Math.round((days_remaining / 4) * i));
    return {
      date: d.toISOString().split("T")[0],
      expected_weight_kg: parseFloat(
        (profile.currentWeight + (weight_delta * (i / 4))).toFixed(1)
      )
    };
  });

  // Safe target date
  const safeRate = goal_type === "bulk" ? 0.5 : 0.75;
  const safeWeeks = Math.ceil(Math.abs(weight_delta) / safeRate);
  const safeDate = new Date(today);
  safeDate.setDate(safeDate.getDate() + safeWeeks * 7);

  // Feasibility — YOU check rules
  const feasibility = checkFeasibility({
    days_remaining, weekly_change, recommended_calories,
    goal_type, bmi, gender: profile.gender
  });

  return {
    // raw values
    days_remaining, weight_delta, weekly_change,
    goal_type, bmi, bmr, tdee,
    recommended_calories, daily_calories,
    macros, milestones,
    safe_target_date: safeDate.toISOString().split("T")[0],
    safe_weekly_rate: safeRate,
    feasibility
  };
}

function computeMacros(goal_type, daily_calories, profile) {
  let protein_g, fat_g, carbs_g;

  if (goal_type === "bulk") {
    protein_g = Math.round(2.2 * profile.targetWeight);
    fat_g = Math.round((daily_calories * 0.25) / 9);
  } else if (goal_type === "cut") {
    protein_g = Math.round(2.5 * profile.currentWeight);
    fat_g = Math.round((daily_calories * 0.22) / 9);
  } else {
    protein_g = Math.round(1.8 * profile.currentWeight);
    fat_g = Math.round((daily_calories * 0.27) / 9);
  }

  const protein_kcal = protein_g * 4;
  const fat_kcal = fat_g * 9;
  carbs_g = Math.round((daily_calories - protein_kcal - fat_kcal) / 4);

  return { protein_g, carbs_g, fat_g };
}

function checkFeasibility({ days_remaining, weekly_change,
  recommended_calories, goal_type, bmi, gender }) {

  if (days_remaining <= 0)
    return { passed: false, failed_rule: "DATE",
      reason: "Target date is today or has already passed." };

  if (weekly_change > 1.0)
    return { passed: false, failed_rule: "RATE",
      reason: `Gaining ${weekly_change}kg/week exceeds safe max of 1.0kg/week.` };

  if (weekly_change < -1.25)
    return { passed: false, failed_rule: "RATE",
      reason: `Losing ${Math.abs(weekly_change)}kg/week exceeds safe max of 1.25kg/week.` };

  const floor = gender === "male" ? 1500 : 1200;
  if (recommended_calories < floor)
    return { passed: false, failed_rule: "FLOOR",
      reason: `Required intake of ${recommended_calories} kcal is below safe minimum.` };

  if (goal_type === "bulk" && bmi >= 27)
    return { passed: false, failed_rule: "BMI_CONFLICT",
      reason: `Bulking not recommended at BMI ${bmi}. Consider cutting first.` };

  if (goal_type === "cut" && bmi <= 17.5)
    return { passed: false, failed_rule: "BMI_CONFLICT",
      reason: `Cutting not safe at BMI ${bmi}. Currently underweight.` };

  return { passed: true, failed_rule: null, reason: null };
}


