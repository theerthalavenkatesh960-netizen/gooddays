WEEKLY CHANGE: ${computed.weekly_change} kg/week
BMI: ${computed.bmi}
FEASIBLE: ${computed.feasibility.passed}
FAILED RULE: ${computed.feasibility.failed_rule || "none"}

ACTIVITY LEVEL RULE:
  bulk → recommend "active" or "very-active"
  cut → recommend "moderate" or "active"  
  maintain → recommend "light" or "moderate"

WARNING RULES (add to warnings array if true, else empty array):
  - If bulk AND weekly_change > 0.75: "Aggressive bulk pace. Expect some fat gain."
  - If cut AND weekly_change < -1.0: "Aggressive cut. Risk of muscle loss."
  - If bmi < 18.5: "Currently underweight. Prioritize calorie-dense whole foods."

INTERIM FOCUS RULE (only if feasible=false):
  bulk: "Focus on progressive overload and hitting protein targets daily."
  cut:  "Focus on resistance training to preserve muscle during deficit."

USE THESE EXACT VALUES — DO NOT CHANGE ANY NUMBER:
{
  "feasible": ${computed.feasibility.passed},
  "goal_type": "${computed.goal_type}",
  "bmi": ${computed.bmi},
  "bmr": ${computed.bmr},
  "tdee": ${computed.tdee},
  "days_remaining": ${computed.days_remaining},
  "weekly_change_needed_kg": ${computed.weekly_change},
  "feasibility_check": {
    "passed": ${computed.feasibility.passed},
    "failed_rule": ${computed.feasibility.failed_rule ? `"${computed.feasibility.failed_rule}"` : "null"},
    "reason": ${computed.feasibility.reason ? `"${computed.feasibility.reason}"` : "null"}
  },
  "recommendation": ${computed.feasibility.passed ? `{
    "daily_calories": ${computed.daily_calories},
    "activity_level": "FILL_THIS",
    "macros": {
      "protein_g": ${computed.macros.protein_g},
      "carbs_g": ${computed.macros.carbs_g},
      "fat_g": ${computed.macros.fat_g}
    },
    "warnings": ["FILL_THIS"],
    "milestones": ${JSON.stringify(computed.milestones)}
  }` : "null"},
  "alternative_plan": ${!computed.feasibility.passed ? `{
    "safe_target_date": "${computed.safe_target_date}",
    "safe_weekly_rate_kg": ${computed.safe_weekly_rate},
    "interim_focus": "FILL_THIS"
  }` : "null"}
}

Return the JSON above with FILL_THIS replaced. 
No markdown. No backticks. Start with { end with }.
`;
}


// ── STEP 3: ASSEMBLE FINAL RESULT ───────────────────────
export async function getFitnessRecommendation(profile) {
  const computed = computeProfile(profile);

  // If all rules pass, we can even skip llama entirely for simple cases
  const prompt = buildPrompt(computed, profile);

  const raw = await callOllama(prompt);
  return extractJSON(raw);
}