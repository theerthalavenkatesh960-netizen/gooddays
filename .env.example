# GoodDays Environment Configuration Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit this file to version control

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================

# PostgreSQL Connection Details
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gooddays

# Full Database Connection String (alternative to individual settings)
# Format: postgresql://username:password@host:port/database
# If DATABASE_URL is set, it will be used instead of individual DB_* variables
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/gooddays

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=2000

# ===================================================================
# APPLICATION ENVIRONMENT
# ===================================================================

# Node Environment (development, staging, production)
NODE_ENV=development

# ===================================================================
# API CONFIGURATION
# ===================================================================

# Backend API Settings
API_PORT=5000
API_HOST=localhost
API_URL=http://localhost:5000

# Frontend (Vite) API base URL used by src/lib/api.ts
VITE_API_URL=https://gooddays.onrender.com

# Frontend dummy/live data source flags (true = dummy data, false = real API)
VITE_USE_DUMMY_SETTINGS=false
VITE_USE_DUMMY_WORKOUT=false
VITE_USE_DUMMY_DAILY_ROUTINE=false
VITE_USE_DUMMY_GOALS=false
VITE_USE_DUMMY_FINANCE=false
VITE_USE_DUMMY_VEHICLES=false
VITE_USE_DUMMY_MEALS=false
VITE_USE_DUMMY_WATER=false
VITE_USE_DUMMY_BODY_METRICS=false
VITE_USE_DUMMY_QUICK_LOG=false

# Frontend Settings
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173

# ===================================================================
# AUTHENTICATION & SECURITY
# ===================================================================

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_minimum_32_characters
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Session Configuration
SESSION_SECRET=your_session_secret_here
COOKIE_SECURE=false

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# ===================================================================
# GOOGLE OAUTH (Optional)
# ===================================================================

# Get these from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# ===================================================================
# EMAIL CONFIGURATION (Optional)
# ===================================================================

# Email Service: 'gmail', 'sendgrid', 'mailgun', 'smtp'
EMAIL_SERVICE=gmail
EMAIL_FROM=your-email@example.com

# Gmail Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your_gmail_app_password

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key

# Mailgun Configuration
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your-domain.mailgun.org

# Custom SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your_email_password

# ===================================================================
# FILE STORAGE (Optional)
# ===================================================================

# File Storage: 'local', 's3', 'google-cloud', 'azure'
STORAGE_TYPE=local
UPLOADS_DIR=./uploads

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=gooddays-bucket
AWS_S3_REGION=us-east-1

# Google Cloud Storage Configuration
GCP_PROJECT_ID=your_gcp_project_id
GCP_STORAGE_BUCKET=gooddays-gcp-bucket
GCP_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json

# Azure Blob Storage Configuration
AZURE_STORAGE_ACCOUNT=youraccountname
AZURE_STORAGE_KEY=your_storage_key
AZURE_CONTAINER=gooddays

# ===================================================================
# LOGGING & MONITORING
# ===================================================================

# Log Level: 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=debug

# Log Format: 'json', 'text'
LOG_FORMAT=text

# Application Insights / Sentry (Optional)
SENTRY_DSN=
APPLICATION_INSIGHTS_CONNECTION_STRING=

# ===================================================================
# FEATURE FLAGS (Optional)
# ===================================================================

# Enable/Disable Features
ENABLE_WORKOUTS=true
ENABLE_GOALS=true
ENABLE_JOURNAL=true
ENABLE_THESIS_TRACKING=true
ENABLE_FINANCIAL_TRACKER=true
ENABLE_GAMIFICATION=true

# Beta Features
ENABLE_BETA_FEATURES=false
BETA_USER_IDS=user1,user2,user3

# ===================================================================
# THIRD-PARTY INTEGRATIONS
# ===================================================================

# Analytics: 'google', 'mixpanel', 'amplitude', 'segment'
ANALYTICS_PROVIDER=google
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Stripe Payment Integration
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# Twilio SMS Integration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ===================================================================
# BACKGROUND JOBS (Optional)
# ===================================================================

# Job Queue: 'bull', 'bee-queue', 'agenda'
JOB_QUEUE_PROVIDER=bull
REDIS_URL=redis://localhost:6379/0

# Cron Jobs
ENABLE_CRON_JOBS=true
BACKUP_SCHEDULE=0 2 * * *
NOTIFICATION_CHECK_INTERVAL=*/5 * * * *

# ===================================================================
# DEVELOPER SETTINGS
# ===================================================================

# Debug Mode (logs additional information)
DEBUG=false

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_URL=/api-docs

# REPL/Testing
ALLOW_EXEC_COMMANDS=false
TEST_MODE=false

# ===================================================================
# NOTES
# ===================================================================
# 
# 1. SECURITY WARNING:
#    - Never commit this file to version control
#    - Use strong, unique passwords for all services
#    - Rotate secrets regularly in production
#    - Use environment variables for sensitive data
#
# 2. INSTALLATION:
#    - Copy this file: cp .env.example .env.local
#    - Fill in your values
#    - Install dependencies: npm install
#    - Run migrations: npm run migrate
#    - Start dev server: npm run dev
#
# 3. ENVIRONMENT-SPECIFIC:
#    - Development: .env.local (git-ignored)
#    - Staging: .env.staging (git-ignored)
#    - Production: Use CI/CD secrets, not files
#
# 4. REQUIRED FOR RUNNING:
#    - DB_* settings (database connection)
#    - NODE_ENV (application mode)
#
# 5. OPTIONAL BUT RECOMMENDED:
#    - JWT_SECRET (authentication)
#    - CORS_ORIGIN (API security)
#    - LOG_LEVEL (debugging)
#
# 6. GENERATE SECRETS:
#    # JWT Secret
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#    # Session Secret
#    node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
#
